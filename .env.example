# Traefik / Let's Encrypt
ACME_EMAIL=your-email@example.com
DOMAIN=example.com

# Obsidian Sync credentials
OBSIDIAN_EMAIL=your-obsidian-email@example.com
OBSIDIAN_PASSWORD=your-account-password
VAULT_PASSWORD=your-vault-encryption-password
VAULT_NAME=My-Vault

# API Security (internal auth between obsidian_mcp.py and obsidian-api.js only)
API_TOKEN=your-secure-random-token-here

# API Ports (usually no need to change)
OBSIDIAN_API_PORT=3000

# Webhooks (optional)
# Allow webhooks to target private/internal/loopback addresses (e.g. a self-hosted
# receiver on the same network). Leave false to keep strict SSRF protection (public https only).
WEBHOOK_ALLOW_PRIVATE=false

# Trash (optional)
# Soft-deleted files are moved to .trash/ and permanently purged after this many days.
# Set to 0 to disable auto-purge (keep trashed files forever).
TRASH_RETENTION_DAYS=30

# OAuth 2.1 (MCP server) — Zitadel resource-server config
# ZITADEL_ISSUER and OAUTH_REQUIRED_ROLE have sane defaults baked into docker-compose.yml;
# override here only if you point at a different Zitadel instance/project/role.
# ZITADEL_ISSUER=https://zitadel-k9z6.srv828065.hstgr.cloud
# OAUTH_REQUIRED_ROLE=obsidian:access
# Role required on top of the above to manage API tokens from MCP
# (create/list/revoke). Grant it in Zitadel to the identities that should be
# able to hand out credentials; revoke it there to take the capability back.
# OAUTH_ADMIN_ROLE=obsidian:admin
