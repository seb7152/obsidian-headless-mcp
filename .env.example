# Traefik / Let's Encrypt
ACME_EMAIL=your-email@example.com
DOMAIN=example.com

# Obsidian Sync credentials
OBSIDIAN_EMAIL=your-obsidian-email@example.com
OBSIDIAN_PASSWORD=your-account-password
VAULT_PASSWORD=your-vault-encryption-password
VAULT_NAME=My-Vault

# API Security
API_TOKEN=your-secure-random-token-here

# API Ports (usually no need to change)
OBSIDIAN_API_PORT=3000

# Webhooks (optional)
# Allow webhooks to target private/internal/loopback addresses (e.g. a self-hosted
# receiver on the same network). Leave false to keep strict SSRF protection (public https only).
WEBHOOK_ALLOW_PRIVATE=false
